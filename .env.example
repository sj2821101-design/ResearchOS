# ResearchOS V1 环境变量示例：复制为 .env 后按需填写。
# 所有变量均可省略；不填时系统回退到"本地启发式分析"，无需任何 API Key 即可端到端演示。

# 数据目录（论文 PDF、analysis.json、SQLite 等），默认项目根目录下的 data/
RESEARCHOS_DATA_DIR=./data

# 服务监听地址与端口
RESEARCHOS_HOST=127.0.0.1
RESEARCHOS_PORT=8000

# LLM Provider：openai | anthropic | openai_compatible | heuristic
# heuristic 表示始终使用本地启发式分析（无需联网、无需 Key）
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-chat

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI 兼容端点（DeepSeek / Ollama / vLLM / LM Studio / 通义 / 智谱 等）---
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPATIBLE_API_KEY=
